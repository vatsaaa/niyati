#!/usr/bin/env bash
# Pre-push hook for Niyati project

set -e

echo "🚀 Running pre-push checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo -e "${YELLOW}Pushing branch: $BRANCH${NC}"

# Prevent pushing to main/master without proper checks
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
    echo -e "${RED}⚠️  Warning: Pushing to $BRANCH${NC}"
    read -p "Are you sure you want to push to $BRANCH? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Push cancelled${NC}"
        exit 1
    fi
fi

# Run full test suite
echo -e "${YELLOW}Running full test suite...${NC}"

# BFF tests: run tests for platform and auth apps if present
for bff_app in apps/bff-platform apps/bff-auth; do
    if [ -d "$bff_app" ]; then
        cd "$bff_app"
        if npm run | grep -q "test"; then
            echo "  → Running tests for $bff_app..."
            npm test || { echo -e "${RED}❌ Tests failed for $bff_app${NC}"; exit 1; }
        fi
        cd - >/dev/null
    fi
done

# UI tests
if [ -d "ui" ]; then
    cd ui
    if npm run | grep -q "test"; then
        echo "  → Running UI tests..."
        npm test || {
            echo -e "${RED}❌ UI tests failed${NC}"
            exit 1
        }
    fi
    cd ..
fi

# Build check
echo -e "${YELLOW}Verifying builds...${NC}"

# Build UI
if [ -d "ui" ]; then
    cd ui
    if npm run | grep -q "build"; then
        echo "  → Building UI..."
        npm run build || {
            echo -e "${RED}❌ UI build failed${NC}"
            exit 1
        }
    fi
    cd ..
fi

echo -e "${GREEN}✅ All pre-push checks passed!${NC}"
exit 0
