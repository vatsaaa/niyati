# Niyati production env example — DO NOT COMMIT SECRETS
# Copy this to infra/.env and fill values (do not commit infra/.env)

# Auth
ACCESS_TOKEN_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_ME

# API keys
ASTRO_API_KEY=REPLACE_ME
GEOCODE_MAPS_KEY=REPLACE_ME

# Database
POSTGRES_DB=niyati_prod
POSTGRES_USER=niyati
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_PORT=5432
DATABASE_URL=postgresql://niyati:REPLACE_ME@postgres:5432/niyati_prod

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
EMAIL_FROM=

# Worker token
WORKER_TOKEN=REPLACE_ME

# Service settings
SERVICE_TOKEN=REPLACE_ME
BASE_URL=https://your.production.url

# Operational
NODE_ENV=production
LOG_LEVEL=info

# NOTE: Keep this file free of real secrets in the repo. Use a secrets manager or
# local `infra/.env` that is excluded from git for real deployments.
