{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "build:ci": "vite build --mode production",
    "serve:dist": "serve -s dist -l 4173",
    "pwa:check": "node ./scripts/lighthouse_check.js",
    "pwa:check:auto": "bash ./scripts/pwa_check_with_server.sh",
    "preview:staging": "vite preview --mode staging",
    
    "format": "prettier --write 'src/**/*.{js,jsx,css}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,css}'",
    "test": "vitest --run --environment jsdom",
    "check-size": "node ./scripts/check-size.cjs",
    "type-check": "echo 'No TypeScript configured' && exit 0",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "dompurify": "^3.0.6",
    "lucide-react": "^0.553.0",
    "marked": "^17.0.1",
    "chrono-node": "^2.3.1",
    "wink-nlp": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "lighthouse": "^10.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "rollup-plugin-visualizer": "^5.8.0",
    "serve": "^14.1.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.2.2",
    "vitest": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.0"
  }
}