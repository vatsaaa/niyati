# Example environment variables for the UI (do NOT commit secrets here)
# Copy this file to `.env.local` and update values as needed for local development.

# App version
VITE_APP_VERSION=0.1.0

# Backend BFF base URL
VITE_BFF_BASE_URL=http://localhost:3000

# N8N webhook URL (use ngrok public URL if exposing to external services)
VITE_N8N_WEBHOOK_URL=https://<your-ngrok-id>.ngrok.io/webhook/chat

# Debug flags
VITE_DEBUG_MODE=true
VITE_VERBOSE_LOGGING=false

# Sentry (optional) - if present, production builds will emit sourcemaps for upload
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN=
