# BFF Environment Variables for Docker - EXAMPLE
# Copy this file to .env.bff and update with your actual values
# DO NOT commit .env.bff (it's gitignored)

# Environment
NODE_ENV=development

# Server
PORT=3000

# Required API Keys - REPLACE WITH YOUR ACTUAL KEYS
ASTRO_API_URL=https://api.example-astrology.com/v1/compute
ASTRO_API_KEY=your_astrology_api_key_here

# Geocoding - REPLACE WITH YOUR ACTUAL KEY
GEOCODE_MAPS_KEY=your_geocode_api_key_here
GEOCODE_CACHE_TTL=86400
GEOCODE_RETRIES=3
GEOCODE_BASE_DELAY_MS=400
GEOCODE_MAX_DELAY_MS=5000

# Logging
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
STRICT_RATE_LIMIT_WINDOW_MS=60000
STRICT_RATE_LIMIT_MAX_REQUESTS=20

# Compression
COMPRESSION_THRESHOLD=1024
COMPRESSION_LEVEL=6

# Performance thresholds
SLOW_REQUEST_MS=1000
VERY_SLOW_REQUEST_MS=3000

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000
SHUTDOWN_GRACE_PERIOD_MS=1000

# Optional: ngrok for webhooks (development only)
NGROK_AUTH_TOKEN=
