# Docker Compose Override - Development Environment
# This file is automatically loaded when running `docker compose up`
# It adds developer-friendly features like hot-reload and source mounts

services:
  bff-auth:
    volumes:
      - ./be/bff-auth:/app
      - /app/node_modules
    environment:
      - LOG_LEVEL=debug

  bff-platform:
    volumes:
      - ./be/bff-platform:/app
      - /app/node_modules
    environment:
      - LOG_LEVEL=debug

  ui-service:
    volumes:
      - ./ui:/app
      - ui-node-modules:/app/node_modules
    environment:
      - LOG_LEVEL=debug
