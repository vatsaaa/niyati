# Vite environment variables for development
# Copy to .env.local and customize (do NOT commit .env.local)

# Build mode
VITE_APP_VERSION=0.1.0-dev

# API endpoints (override defaults from config)
VITE_BFF_BASE_URL=http://localhost:3000
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chat

# Feature flags
VITE_DEBUG_MODE=true
VITE_VERBOSE_LOGGING=true
