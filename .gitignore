# Project .gitignore — Node + Vite UI + macOS/editor ignores

# Node modules
node_modules/

# UI (Vite) build artifacts and deps
/ui/dist/
/ui/.vite/
/ui/node_modules/
/ui/build/

# Environment files (do NOT commit secrets)
.env*
.env.local
.env.*.local
/ui/.env.local
/ui/.env.*.local
# Legacy `be/` envs removed; ignore app envs instead
/apps/bff-platform/.env
/apps/bff-auth/.env

# Docker environment files (do NOT commit)
.env.bff
.env.bff.local
.env.ui
.env.ui.local

# Docker secrets directory (NEVER commit!)
/infra/secrets/
secrets/

# Allow environment templates (these should be committed)
!.env.development
!.env.staging
!.env.production
!.env.example
!.env.bff.example
!.env.ui.example
!/ui/.env.development
!/ui/.env.staging
!/ui/.env.production
!/apps/bff-platform/.env.example
!/apps/bff-auth/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage and test output
coverage/
.nyc_output/
.nyc_output_merge/
artifacts/

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.iml

# Misc caches and temp
.cache/
.tmp/
dist/
build/

# Certificates and keys
*.pem
*.key
*.crt

# Database / local storage
*.sqlite
*.db

# Docker override (local)
docker-compose.override.yml
# Local prod overrides for testing without GHCR auth
**/docker-compose.*.local.yml

# ngrok and local tunnels
.ngrok/

# Misc
*.tgz
*.log.gz

# Keep lockfiles in source control (do not ignore package-lock.json/yarn.lock by default)

# Playwright (UI)
/ui/test-results/
/ui/playwright-report/

/infra/secrets
