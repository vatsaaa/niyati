{
  "name": "niyati-bff",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "start:staging": "NODE_ENV=staging node src/index.js",
    "start:prod": "NODE_ENV=production node src/index.js",
    "simulate:webhook": "node scripts/simulate_webhook.js --url http://localhost:3000/api/webhook --body scripts/sample_event.json",
    "test:integ": "node scripts/test_endpoints.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:load": "artillery run tests/load/baseline.yml",
    "test:all": "npm run test:unit && npm run test:integration",
    "lint": "eslint 'src/**/*.js' 'config/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' 'config/**/*.js' --fix",
    "format": "prettier --write 'src/**/*.js' 'config/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'config/**/*.js'",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^6.0.1",
    "node-cache": "^5.1.2",
    "pino": "^8.17.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4"
  }
}
