# Copy to .env and fill secrets (do NOT commit .env)

# Required variables - server will fail fast at startup if these are missing
PORT=3000
ASTRO_API_URL=https://api.example-astrology.com/v1/compute
ASTRO_API_KEY=rbFZQW05Fj6r382kuCNIA4A2rthPHHmVXBRXuQo2

# Recommended variables - server will warn if missing but continue
GEOCODE_MAPS_KEY=692331f47b1fb572260859afrd77c62
NODE_ENV=development
LOG_LEVEL=info

# Optional testing
NGROK_AUTH_TOKEN=

# Environment-specific configs are in be/bff/config/ directory
# Values below can override config file defaults

# Geocoding & retry/backoff configuration
# Time-to-live for geocode cache (seconds). Default: 86400 (24h)
GEOCODE_CACHE_TTL=86400
# Number of retries for external geocode requests (transient errors: 429,502,503,504). Default: 3
GEOCODE_RETRIES=3
# Base delay (ms) used for exponential backoff. Final delay includes jitter. Default: 400
GEOCODE_BASE_DELAY_MS=400
# Maximum delay (ms) for exponential backoff. Default: 5000
GEOCODE_MAX_DELAY_MS=5000

# Rate limiting configuration
# General API rate limit window (ms). Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window for general endpoints. Default: 100
RATE_LIMIT_MAX_REQUESTS=100
# Strict rate limit window for expensive endpoints (geocode, astrology). Default: 60000
STRICT_RATE_LIMIT_WINDOW_MS=60000
# Max requests per window for expensive endpoints. Default: 20
STRICT_RATE_LIMIT_MAX_REQUESTS=20
# Graceful shutdown timeout (ms). Default: 10000 (10 seconds)
SHUTDOWN_TIMEOUT_MS=10000

# Compression configuration
# Minimum size to compress (bytes). Default: 1024 (1KB)
COMPRESSION_THRESHOLD=1024
# Compression level (0-9). Default: 6
COMPRESSION_LEVEL=6

# Response time logging thresholds (ms)
# Warn if request takes longer than this. Default: 1000
SLOW_REQUEST_MS=1000
# Error if request takes longer than this. Default: 3000
VERY_SLOW_REQUEST_MS=3000
