# UI Environment Variables for Docker - EXAMPLE
# Copy this file to .env.ui and customize as needed
# DO NOT commit .env.ui with sensitive data (it's gitignored)

# App version
VITE_APP_VERSION=0.1.0-dev

# BFF API endpoint
# For development (browser access from host)
VITE_BFF_BASE_URL=http://localhost:3000

# For production (update with your actual domain)
# VITE_BFF_BASE_URL=https://api.yourdomain.com

# N8N Webhook (if using)
# VITE_N8N_WEBHOOK_URL=https://your-webhook-url.com/webhook/chat

# Feature flags
VITE_DEBUG_MODE=true
VITE_VERBOSE_LOGGING=true
