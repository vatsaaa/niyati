# Caddyfile.dev - Development reverse proxy
# Proxies UI requests to Vite dev server for hot module replacement (HMR)
{
    # Global options
    email {$CADDY_EMAIL:ankur.vatsa@gmail.com}
    debug
    # Disable HTTPS for local development - use HTTP only
    auto_https off
}

# HTTP server on port 5173 for development
http://localhost:5173, http://127.0.0.1:5173, http://{$DOMAIN:localhost}:5173 {

    # Enable gzip compression
    encode gzip

    # Security headers (relaxed for development)
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    # CORS headers for API routes and webhook
    @api_and_webhook path /api/* /webhook/*
    header @api_and_webhook {
        -Access-Control-Allow-Origin
        Access-Control-Allow-Origin "{http.request.header.Origin}"
        Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        Access-Control-Allow-Credentials "true"
        Access-Control-Max-Age "3600"
    }

    # Handle preflight OPTIONS requests for CORS
    @options method OPTIONS
    handle @options {
        header {
            -Access-Control-Allow-Origin
            Access-Control-Allow-Origin "{http.request.header.Origin}"
            Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
            Access-Control-Allow-Credentials "true"
            Access-Control-Max-Age "3600"
        }
        respond "" 204
    }

    # Health check endpoint
    handle /health {
        respond "healthy" 200
    }

    # BFF Auth API routes (specific auth endpoints + users)
    # Route platform-only user actions (deductions) to bff-platform
    handle /api/v1/users/deduct-credits {
        reverse_proxy bff-platform:{$BFF_PLATFORM_PORT:3000} {
            health_uri /api/v1/telemetry/health
            health_interval 30s
            health_timeout 10s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/v1/users/add-credits {
        reverse_proxy bff-platform:{$BFF_PLATFORM_PORT:3000} {
            health_uri /api/v1/telemetry/health
            health_interval 30s
            health_timeout 10s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/v1/users/* {
        reverse_proxy bff-auth:{$BFF_AUTH_PORT:3001} {
            health_uri /api/v1/telemetry/health
            health_interval 30s
            health_timeout 10s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /api/v1/auth/* {
        reverse_proxy bff-auth:{$BFF_AUTH_PORT:3001} {
            health_uri /api/v1/telemetry/health
            health_interval 30s
            health_timeout 10s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # N8N Webhook route - proxy to local n8n instance
    handle /webhook/* {
        reverse_proxy host.docker.internal:5678 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # BFF Platform API routes (catch-all for /api/*)
    handle /api/* {
        reverse_proxy bff-platform:{$BFF_PLATFORM_PORT:3000} {
            health_uri /api/v1/telemetry/health
            health_interval 30s
            health_timeout 10s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # UI - proxy to Vite dev server for hot module replacement (HMR)
    # In development, ui-service runs Vite on port 5173
    handle /* {
        reverse_proxy ui-service:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Access log
    log {
        output stdout
        format json
        level INFO
    }
}
